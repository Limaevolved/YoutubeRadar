{
  "manifest_version": 3,
  "name": "YoutubeRadar",
  "version": "1.0.0",
  "description": "Manda pro Discord o que tá tocando no YouTube.",
  "host_permissions": ["http://127.0.0.1:3737/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
